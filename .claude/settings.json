{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git config *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete*)"
    ]
  }
}
