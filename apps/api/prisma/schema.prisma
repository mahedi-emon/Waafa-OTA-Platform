// WAAFA launch data model (decision D125). Transactional records have their own tables with indexes on every
// filter and sort; admin-managed content and settings are validated JSON documents (packages/shared CONTENT_MODEL).
// Money is whole taka (Int); times are timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Staff and sessions ------------------------------------------------------------------------------------------

model StaffUser {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String
  /// Role keys from packages/shared RoleSchema.
  roles           String[]
  status          String         @default("active")
  failedLogins    Int            @default(0)
  lockedUntil     DateTime?      @db.Timestamptz(3)
  lastLoginAt     DateTime?      @db.Timestamptz(3)
  /// SHA-256 of an open invite's token (the token itself is only in the email); cleared once a password is chosen.
  inviteHash      String?        @unique
  inviteExpiresAt DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  sessions        StaffSession[]
}

model StaffSession {
  id          String    @id @default(cuid())
  userId      String
  user        StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token; the token itself is never stored.
  refreshHash String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  /// Set when the session was closed by a refresh (rotation), not by sign-out or reuse detection.
  rotatedAt   DateTime? @db.Timestamptz(3)
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// References and idempotency ----------------------------------------------------------------------------------

model ReferenceSequence {
  prefix String
  /// Asia/Dhaka date as YYMMDD.
  day    String
  value  Int

  @@id([prefix, day])
}

model IdempotencyRecord {
  key       String   @id
  scope     String
  status    Int
  response  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// Leads -------------------------------------------------------------------------------------------------------

model Lead {
  id              String         @id @default(cuid())
  reference       String         @unique
  module          String
  status          String         @default("new")
  priority        String         @default("normal")
  name            String
  /// E.164, used by the duplicate guard and search.
  phone           String
  email           String?
  contact         Json
  payload         Json
  source          Json
  summary         String
  travelDate      String?
  travellers      Int?
  assigneeId      String?
  amount          Int?
  reason          String?
  duplicateOfId   String?
  /// Visa application progress (D0 R4, D225): checklist items received, submission, outcome, passport returned.
  progress        Json?
  firstResponseAt DateTime?      @db.Timestamptz(3)
  closedAt        DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  activities      LeadActivity[]

  @@index([module, status, createdAt])
  @@index([status, createdAt])
  @@index([phone, module, createdAt])
  @@index([assigneeId, status])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  body      String
  actorId   String?
  actorName String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
}

model SearchLog {
  id              String   @id @default(cuid())
  module          String
  summary         String
  params          Json
  device          String?
  source          String?
  convertedLeadId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([module, createdAt])
  @@index([createdAt])
}

// Waafas World orders -----------------------------------------------------------------------------------------

model Order {
  id              String       @id @default(cuid())
  reference       String       @unique
  status          String       @default("placed")
  /// OrderItem[] price snapshot (packages/shared OrderItemSchema).
  items           Json
  subtotal        Int
  discount        Int
  delivery        Int
  total           Int
  couponCode      String?
  payment         Json
  paymentVerified Boolean      @default(false)
  address         Json
  name            String
  phone           String
  email           String?
  pickup          Boolean      @default(false)
  invoice         Json?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  history         OrderEvent[]

  @@index([status, createdAt])
  @@index([phone])
  @@index([createdAt])
}

model OrderEvent {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String
  note           String?
  courier        String?
  trackingNumber String?
  actorName      String?
  at             DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, at])
}

// Feedback, payment proofs, newsletter -------------------------------------------------------------------------

model Feedback {
  id               String    @id @default(cuid())
  name             String
  phone            String
  service          String
  reference        String?
  rating           Int?
  comment          String
  /// Photo metadata until uploads land; an approved photo becomes an Image.
  photo            Json?
  consentToPublish Boolean
  status           String    @default("pending")
  moderatedAt      DateTime? @db.Timestamptz(3)
  moderatedBy      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

model PaymentProof {
  id            String    @id @default(cuid())
  reference     String
  name          String
  phone         String
  amount        Int
  accountId     String
  transactionId String?
  proof         Json?
  status        String    @default("received")
  note          String?
  /// The order it pays for, once matched by reference and amount (D0 R4, D222).
  orderId       String?
  decidedAt     DateTime? @db.Timestamptz(3)
  decidedBy     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([reference])
  @@index([status, createdAt])
  @@index([orderId])
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  unsubscribedAt DateTime? @db.Timestamptz(3)
}

// Admin-managed content (validated by packages/shared CONTENT_MODEL) ------------------------------------------------

model ContentDocument {
  /// A CONTENT_MODEL collection key, e.g. "tourPackages".
  collection String
  /// The record's id field (id, slug, key or code).
  docId      String
  data       Json
  /// Admin order, for collections that keep one.
  position   Int      @default(0)
  version    Int      @default(1)
  updatedBy  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([collection, docId])
  @@index([collection, position])
}

/// Deleted content records (D0 R4, D217): off the site at once, restorable for 30 days, then purged.
model TrashItem {
  id         String   @id @default(cuid())
  collection String
  docId      String
  data       Json
  position   Int      @default(0)
  version    Int      @default(1)
  deletedBy  String
  deletedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([deletedAt])
  @@index([collection, docId])
}

/// Old record addresses that redirect to the record's new one (D0 R4, D218).
model SlugRedirect {
  collection String
  fromId     String
  toId       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([collection, fromId])
  @@index([collection, toId])
}

model Setting {
  /// A CONTENT_MODEL singleton key, e.g. "contactSettings".
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Operations ---------------------------------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([at])
}

model NotificationLog {
  id        String    @id @default(cuid())
  channel   String
  recipient String
  template  String
  subject   String
  status    String
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)

  @@index([createdAt])
}

// External API connections ------------------------------------------------------------------------------------

/// One connection per provider and environment (FR-GS-06 to 08, #82). `secrets` holds AES-256-GCM sealed values
/// ("v1.<iv>.<tag>.<ciphertext>") keyed by catalog field; they never leave the API.
model ProviderCredential {
  id            String    @id @default(cuid())
  provider      String
  environment   String
  settings      Json
  secrets       Json
  note          String?
  healthOk      Boolean?
  healthMessage String?
  healthAt      DateTime? @db.Timestamptz(3)
  updatedBy     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, environment])
}

/// One row per provider (#107): which credential set is used (Sandbox or Live), whether the provider is on, and the
/// markup on its prices. Catalog providers get a row on first save; custom providers ("custom-<kind>-<slug>") are
/// added by the Super Admin. Turning a provider on never switches a public module to Live (Golden Switch).
model IntegrationSetting {
  id          String   @id @default(cuid())
  provider    String   @unique
  kind        String
  name        String
  custom      Boolean  @default(false)
  isActive    Boolean  @default(false)
  isLive      Boolean  @default(false)
  markupType  String   @default("none")
  markupValue Decimal  @default(0) @db.Decimal(12, 2)
  updatedBy   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([kind, isActive])
}

// Media library -------------------------------------------------------------------------------------------------

/// An uploaded photo (#109): re-encoded to WebP (max 2560 px, metadata removed) and stored on the media volume at
/// `path` ("2026/10/<id>.webp"); served at /uploads/<path>. Alt text is required.
model MediaAsset {
  id           String   @id @default(cuid())
  path         String   @unique
  alt          String
  width        Int
  height       Int
  bytes        Int
  mime         String
  originalName String?
  uploadedBy   String?
  /// Photo credit offered to every field that uses the file (D0 R3).
  credit       String?
  creditUrl    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

// Customer accounts (FR-ACC, issue 134) ---------------------------------------------------------------------------

/// A visitor who signed in (Google for now). Requests and orders stay guest records; My account lists those sent with
/// this verified email. Deleting the account removes this row and its sessions, never the requests or orders.
model Customer {
  id           String            @id @default(cuid())
  /// Lower-case, verified by Google.
  email        String            @unique
  name         String
  /// Google's stable account ID ("sub").
  googleSub    String?           @unique
  lastSignInAt DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  sessions     CustomerSession[]
}

/// One sign-in. The cookie holds the token; only its SHA-256 is stored.
model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([customerId])
}
