// WAAFA launch data model (decision D125). Transactional records have their own tables with indexes on every
// filter and sort; admin-managed content and settings are validated JSON documents (packages/shared CONTENT_MODEL).
// Money is whole taka (Int); times are timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Staff and sessions ------------------------------------------------------------------------------------------

model StaffUser {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  passwordHash    String
  /// Role keys from packages/shared RoleSchema.
  roles           String[]
  status          String              @default("active")
  failedLogins    Int                 @default(0)
  lockedUntil     DateTime?           @db.Timestamptz(3)
  lastLoginAt     DateTime?           @db.Timestamptz(3)
  /// SHA-256 of an open invite's token (the token itself is only in the email); cleared once a password is chosen.
  inviteHash      String?             @unique
  inviteExpiresAt DateTime?           @db.Timestamptz(3)
  /// Authenticator secret sealed with AES-256-GCM (issue 234); null until two-step sign-in is set up.
  totpSecret      String?
  totpEnabledAt   DateTime?           @db.Timestamptz(3)
  /// The last 30-second step a code was accepted for: the same or an older code is refused (no replay).
  totpLastStep    Int?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  sessions        StaffSession[]
  recoveryCodes   StaffRecoveryCode[]
  devices         StaffDevice[]
  loginEvents     StaffLoginEvent[]
}

/// One-time recovery codes for two-step sign-in (issue 234); only hashes are stored.
model StaffRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([userId, codeHash])
}

/// A browser a staff member signed in from (issue 234): new-device emails and "Trust this device for 30 days".
model StaffDevice {
  id           String    @id @default(cuid())
  userId       String
  user         StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the browser's device cookie; the cookie itself is never stored.
  deviceHash   String
  /// "Chrome on Windows", read from the user agent.
  label        String
  lastIp       String?
  firstSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// The code step is skipped on this device until then; null when it isn't trusted.
  trustedUntil DateTime? @db.Timestamptz(3)

  @@unique([userId, deviceHash])
}

/// Every staff sign-in attempt for a known account (issue 234): time, device, address and result.
model StaffLoginEvent {
  id        String    @id @default(cuid())
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// success | recovery-code | wrong-password | wrong-code | locked | paused
  result    String
  ip        String?
  device    String?
  newDevice Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model StaffSession {
  id          String    @id @default(cuid())
  userId      String
  user        StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token; the token itself is never stored.
  refreshHash String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  /// Set when the session was closed by a refresh (rotation), not by sign-out or reuse detection.
  rotatedAt   DateTime? @db.Timestamptz(3)
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// References and idempotency ----------------------------------------------------------------------------------

model ReferenceSequence {
  prefix String
  /// Asia/Dhaka date as YYMMDD.
  day    String
  value  Int

  @@id([prefix, day])
}

model IdempotencyRecord {
  key       String   @id
  scope     String
  status    Int
  response  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// Leads -------------------------------------------------------------------------------------------------------

model Lead {
  id              String         @id @default(cuid())
  reference       String         @unique
  module          String
  status          String         @default("new")
  priority        String         @default("normal")
  name            String
  /// E.164, used by the duplicate guard and search.
  phone           String
  email           String?
  contact         Json
  payload         Json
  source          Json
  summary         String
  travelDate      String?
  travellers      Int?
  assigneeId      String?
  amount          Int?
  reason          String?
  duplicateOfId   String?
  /// Visa application progress (D0 R4, D225): checklist items received, submission, outcome, passport returned.
  progress        Json?
  firstResponseAt DateTime?      @db.Timestamptz(3)
  closedAt        DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  activities      LeadActivity[]
  booking         Booking?
  quotes          Quote[]
  /// The customer account the request belongs to (#241): set when the same email is verified, by phone when the
  /// request has no email, or by staff. Cleared if the account is deleted.
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([module, status, createdAt])
  @@index([status, createdAt])
  @@index([phone, module, createdAt])
  @@index([assigneeId, status])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  body      String
  actorId   String?
  actorName String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
}

model SearchLog {
  id              String   @id @default(cuid())
  module          String
  summary         String
  params          Json
  device          String?
  source          String?
  convertedLeadId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([module, createdAt])
  @@index([createdAt])
}

// Waafa’s World orders -----------------------------------------------------------------------------------------

model Order {
  id              String       @id @default(cuid())
  reference       String       @unique
  status          String       @default("placed")
  /// OrderItem[] price snapshot (packages/shared OrderItemSchema).
  items           Json
  subtotal        Int
  discount        Int
  delivery        Int
  total           Int
  couponCode      String?
  payment         Json
  paymentVerified Boolean      @default(false)
  address         Json
  name            String
  phone           String
  email           String?
  pickup          Boolean      @default(false)
  invoice         Json?
  /// Where the buyer came from: UTM, referrer, landing page (issue 237).
  source          Json?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  history         OrderEvent[]
  /// The customer account the order belongs to (#241); attached like a lead's.
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@index([createdAt])
}

model OrderEvent {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String
  note           String?
  courier        String?
  trackingNumber String?
  actorName      String?
  at             DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, at])
}

// Feedback, payment proofs, newsletter -------------------------------------------------------------------------

model Feedback {
  id               String    @id @default(cuid())
  name             String
  phone            String
  service          String
  reference        String?
  rating           Int?
  comment          String
  /// Photo metadata until uploads land; an approved photo becomes an Image.
  photo            Json?
  consentToPublish Boolean
  status           String    @default("pending")
  moderatedAt      DateTime? @db.Timestamptz(3)
  moderatedBy      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

model PaymentProof {
  id            String    @id @default(cuid())
  reference     String
  name          String
  phone         String
  amount        Int
  accountId     String
  transactionId String?
  proof         Json?
  status        String    @default("received")
  note          String?
  /// The order it pays for, once matched by reference and amount (D0 R4, D222).
  orderId       String?
  decidedAt     DateTime? @db.Timestamptz(3)
  decidedBy     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([reference])
  @@index([status, createdAt])
  @@index([orderId])
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  unsubscribedAt DateTime? @db.Timestamptz(3)
}

// Admin-managed content (validated by packages/shared CONTENT_MODEL) ------------------------------------------------

model ContentDocument {
  /// A CONTENT_MODEL collection key, e.g. "tourPackages".
  collection String
  /// The record's id field (id, slug, key or code).
  docId      String
  data       Json
  /// Admin order, for collections that keep one.
  position   Int      @default(0)
  version    Int      @default(1)
  updatedBy  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([collection, docId])
  @@index([collection, position])
}

/// Deleted content records (D0 R4, D217): off the site at once, restorable for 30 days, then purged.
model TrashItem {
  id         String   @id @default(cuid())
  collection String
  docId      String
  data       Json
  position   Int      @default(0)
  version    Int      @default(1)
  deletedBy  String
  deletedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([deletedAt])
  @@index([collection, docId])
}

/// Old record addresses that redirect to the record's new one (D0 R4, D218).
model SlugRedirect {
  collection String
  fromId     String
  toId       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([collection, fromId])
  @@index([collection, toId])
}

model Setting {
  /// A CONTENT_MODEL singleton key, e.g. "contactSettings".
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Operations ---------------------------------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([at])
}

model NotificationLog {
  id        String    @id @default(cuid())
  channel   String
  recipient String
  template  String
  subject   String
  status    String
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)

  @@index([createdAt])
}

// External API connections ------------------------------------------------------------------------------------

/// One connection per provider and environment (FR-GS-06 to 08, #82). `secrets` holds AES-256-GCM sealed values
/// ("v1.<iv>.<tag>.<ciphertext>") keyed by catalog field; they never leave the API.
model ProviderCredential {
  id            String    @id @default(cuid())
  provider      String
  environment   String
  settings      Json
  secrets       Json
  note          String?
  healthOk      Boolean?
  healthMessage String?
  healthAt      DateTime? @db.Timestamptz(3)
  updatedBy     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, environment])
}

/// One row per provider (#107): which credential set is used (Sandbox or Live), whether the provider is on, and the
/// markup on its prices. Catalog providers get a row on first save; custom providers ("custom-<kind>-<slug>") are
/// added by the Super Admin. Turning a provider on never switches a public module to Live (Golden Switch).
model IntegrationSetting {
  id          String   @id @default(cuid())
  provider    String   @unique
  kind        String
  name        String
  custom      Boolean  @default(false)
  isActive    Boolean  @default(false)
  isLive      Boolean  @default(false)
  markupType  String   @default("none")
  markupValue Decimal  @default(0) @db.Decimal(12, 2)
  updatedBy   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([kind, isActive])
}

// Media library -------------------------------------------------------------------------------------------------

/// An uploaded photo (#109): re-encoded to WebP (max 2560 px, metadata removed) and stored on the media volume at
/// `path` ("2026/10/<id>.webp"); served at /uploads/<path>. Alt text is required.
model MediaAsset {
  id           String   @id @default(cuid())
  path         String   @unique
  alt          String
  width        Int
  height       Int
  bytes        Int
  mime         String
  originalName String?
  uploadedBy   String?
  /// Photo credit offered to every field that uses the file (D0 R3).
  credit       String?
  creditUrl    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

// Customer accounts (FR-ACC, issue 134) ---------------------------------------------------------------------------

/// A visitor who signed in (Google for now). Requests and orders stay guest records; My account lists those sent with
/// this verified email. Deleting the account removes this row and its sessions, never the requests or orders.
model Customer {
  id              String                 @id @default(cuid())
  /// Lower-case, verified by Google.
  email           String                 @unique
  name            String
  /// Google's stable account ID ("sub").
  googleSub       String?                @unique
  lastSignInAt    DateTime?              @db.Timestamptz(3)
  /// E.164. A contact field the customer typed at sign-up, never verified (D301).
  phone           String?
  /// When the email was proven: a sign-in code, or Google.
  emailVerifiedAt DateTime?              @db.Timestamptz(3)
  /// The last way in: email-code or google.
  signInMethod    String?
  /// Staff turned the account off: no sign-in, every session ended (#241).
  disabledAt      DateTime?              @db.Timestamptz(3)
  /// An optional password set in My account (#278, argon2id); a code sign-in always works too.
  passwordHash    String?
  /// Offers and news emails; service emails about requests and orders always go (#278).
  notifyOffers    Boolean                @default(false)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  sessions        CustomerSession[]
  leads           Lead[]
  orders          Order[]
  wishlist        CustomerWishlistItem[]
  travellers      CustomerTraveller[]
  addresses       CustomerAddress[]

  @@index([phone])
}

/// A package or product a customer saved (#278).
model CustomerWishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// package or product.
  kind       String
  slug       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([customerId, kind, slug])
}

/// A traveller a customer saved for faster requests (#278). The passport number is sealed (AES-256-GCM) and shown
/// masked; only its last four characters are kept in clear for the list.
model CustomerTraveller {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName       String
  dateOfBirth    String?
  nationality    String?
  passportSealed String?
  passportLast4  String?
  passportExpiry String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([customerId])
}

/// A delivery address (#278); the default one prefills checkout.
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  name       String
  phone      String
  division   String
  district   String
  area       String
  street     String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([customerId])
}

/// An email sign-in code (#241, D301). Only an HMAC of the code is kept; it works for 10 minutes, once, with at most
/// 5 tries, and only the newest code for an address counts. A verified code for an address without an account turns
/// into a 15-minute sign-up ticket (hashed) that the name-and-phone step spends.
model CustomerSignInCode {
  id              String    @id @default(cuid())
  /// Lower-case.
  email           String
  codeHash        String
  expiresAt       DateTime  @db.Timestamptz(3)
  attempts        Int       @default(0)
  usedAt          DateTime? @db.Timestamptz(3)
  ticketHash      String?   @unique
  ticketExpiresAt DateTime? @db.Timestamptz(3)
  ip              String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
}

/// One sign-in. The cookie holds the token; only its SHA-256 is stored.
model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([customerId])
}

// Customer files (FR-VISA-03, FR-VISA-05, issue 232) ----------------------------------------------------------------

/// A file a visitor sent with a form: visa documents, payment-proof slips, printing and trading attachments, a feedback
/// photo. Stored on the private volume at `path` (never served by nginx); staff open it through a 10-minute signed
/// link, and every link and download is audited. `storageKey` is the unguessable claim the form sends back; a file no
/// record claims within 24 hours is deleted, visa documents 90 days after their lead closes.
model CustomerFile {
  id          String    @id @default(cuid())
  storageKey  String    @unique
  /// PrivateFileSchema kind: passport-bio, photo, bank-statement, invitation, payment-proof, other.
  kind        String
  fileName    String
  mimeType    String
  sizeBytes   Int
  sha256      String
  path        String    @unique
  /// pending (uploaded, not claimed), attached, deleted.
  status      String    @default("pending")
  /// lead, payment-proof, order, feedback (set when claimed).
  ownerType   String?
  ownerId     String?
  /// Malware scan (#235): unscanned, clean, infected.
  scanStatus  String    @default("unscanned")
  uploaderIp  String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  attachedAt  DateTime? @db.Timestamptz(3)
  deleteAfter DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  @@index([ownerType, ownerId])
  @@index([status, createdAt])
  @@index([deleteAfter])
}

/// A booking made from a converted lead (issue 242, FR-ADM Bookings): the manual record of what was sold. Documents
/// (e-tickets, vouchers, invoices) are CustomerFile rows with ownerType "booking".
model Booking {
  id            String    @id @default(cuid())
  /// "BKG-261030-0001", a per-day sequence in Asia/Dhaka.
  reference     String    @unique
  leadId        String    @unique
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  module        String
  /// confirmed, ticketed, travelled, cancelled
  status        String    @default("confirmed")
  /// unpaid, partial, paid, refunded
  paymentStatus String    @default("unpaid")
  /// Taka, VAT included.
  amount        Int
  paid          Int       @default(0)
  pnr           String?
  tickets       String[]  @default([])
  supplier      String?
  travelDate    DateTime? @db.Date
  notes         String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

/// A quote for a lead's customer (issue 298): fare or package options with baggage and a price, valid until a day
/// in Asia/Dhaka. The customer opens it by a signed link, sees the PDF and accepts one option; staff then convert the
/// lead to a booking.
model Quote {
  id             String    @id @default(cuid())
  /// "QTN-261030-0001", a per-day sequence in Asia/Dhaka.
  reference      String    @unique
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// draft, sent, accepted, withdrawn (expired follows from validUntil)
  status         String    @default("draft")
  /// [{ id, title, details, baggage, price }]; prices in taka, VAT included.
  options        Json
  validUntil     DateTime  @db.Date
  notes          String?
  acceptedOption String?
  acceptedAt     DateTime? @db.Timestamptz(3)
  sentAt         DateTime? @db.Timestamptz(3)
  /// email, whatsapp: how it has been sent so far.
  sentVia        String[]  @default([])
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([leadId, createdAt])
}
