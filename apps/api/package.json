{
  "name": "@waafa/api",
  "version": "0.0.0",
  "private": true,
  "description": "WAAFA API: NestJS on Fastify, PostgreSQL through Prisma, Redis + BullMQ",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "build": "prisma generate && tsc --noEmit && node scripts/build.mjs",
    "start:dist": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.4.0",
    "dotenv": "^17.2.3",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "^6.2.13",
    "nodemailer": "10.2.1",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.34.1",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.5",
    "@waafa/config": "workspace:*",
    "@waafa/fixtures": "workspace:*",
    "@waafa/shared": "workspace:*",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
