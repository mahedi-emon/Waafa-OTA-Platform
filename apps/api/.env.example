# Copy to .env for local work (never commit .env).
NODE_ENV=development
PORT=4000
# Local cluster without Docker: postgresql://waafa@localhost:5433/waafa ; Docker compose: postgresql://waafa:waafa@localhost:5432/waafa
DATABASE_URL=postgresql://waafa@localhost:5433/waafa
# Optional in development (jobs then run in-process); required in production.
REDIS_URL=
# Long random strings (openssl rand -base64 48). Never reuse between environments.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REVALIDATE_SECRET=change-me-to-another-long-random-string
# The public web origin(s), comma separated, for CORS and revalidation.
WEB_ORIGINS=http://localhost:3000
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Server-to-server key the web uses for public intake calls.
INTAKE_KEY=change-me-intake-key-at-least-24-chars
# Email: RESEND_API_KEY in production, or SMTP_URL (Mailpit locally: smtp://localhost:1025).
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Waafa <no-reply@waafasworld.com>"
STAFF_ALERT_EMAIL=info@waafasworld.com
# First Super Admin, created by the seed only when no staff exist.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
