# Copy to .env.local for local work (never commit .env files).

# Public address of the site (canonical URLs, sitemap, share images). Production builds fail without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 on a production host other than Vercel so a missing NEXT_PUBLIC_SITE_URL fails the build.
REQUIRE_SITE_URL=

# API mode (Phase C): with both set, the site reads the content snapshot from the API and sends every form to it.
# Leave empty to run on the Sample fixtures (development, tests).
WAAFA_API_URL=
# The API's INTAKE_KEY (server to server only; never exposed to the browser).
WAAFA_INTAKE_KEY=
# The API's REVALIDATE_SECRET: /api/revalidate accepts only calls signed with it.
REVALIDATE_SECRET=

# Cloudflare Turnstile: set BOTH or neither. The site key draws the widget on every public form (loaded on the first
# focus); the secret turns the server check on. Development can use Cloudflare's always-pass test keys
# 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tests only: raises the per-visitor form limits for the Playwright server.
RATE_LIMIT_FACTOR=
