{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3200",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/flights",
        "http://localhost:3200/hotels",
        "http://localhost:3200/tour-packages",
        "http://localhost:3200/tour-packages/bangkok-and-phuket",
        "http://localhost:3200/visa",
        "http://localhost:3200/visa/thailand",
        "http://localhost:3200/shop",
        "http://localhost:3200/shop/p/voltaro-power-bank-22-5w",
        "http://localhost:3200/blog",
        "http://localhost:3200/blog/coxs-bazar-long-weekend"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
