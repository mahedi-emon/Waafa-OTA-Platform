{
  "name": "waafa-ota-platform",
  "private": true,
  "description": "WAAFA: Waafa Tours and Travel + Waafas World — public site, store, admin and API",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "dev": "turbo run dev --filter=@waafa/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=@waafa/web",
    "guards": "node scripts/guards.mjs && node apps/web/scripts/server-icons.mjs --check && node apps/web/scripts/client-boundary.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@waafa/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10"
  }
}
