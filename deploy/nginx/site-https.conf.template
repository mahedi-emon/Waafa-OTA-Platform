# With the Let's Encrypt certificate: HTTP and www redirect to https://SITE_DOMAIN, which proxies to the web.

upstream waafa_web {
    server web:3000;
    keepalive 32;
}

# Form posts and sign-ins: 30 a minute per address with a short burst (the web and API add their own limits).
map $request_method $waafa_post_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $waafa_post_key zone=waafa_posts:10m rate=30r/m;
limit_req_status 429;

server_tokens off;

ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# Requests for any other host name (bare IP, scanners) are dropped.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 80;
    server_name ${SITE_DOMAIN} www.${SITE_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${SITE_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.${SITE_DOMAIN};
    return 301 https://${SITE_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    client_max_body_size 2m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwritten, never appended: the web's rate limits read the first address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
