# Before the certificate exists (and in the CI smoke run): the ACME challenge plus the site over HTTP.

upstream waafa_web {
    server web:3000;
    keepalive 32;
}

# Uploaded photos (#109) come straight from the API's media volume.
upstream waafa_api {
    server api:4000;
    keepalive 8;
}

# Form posts and sign-ins: 30 a minute per address with a short burst (the web and API add their own limits).
map $request_method $waafa_post_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $waafa_post_key zone=waafa_posts:10m rate=30r/m;
limit_req_status 429;

server_tokens off;

# Requests for any other host name (bare IP, scanners) are dropped.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 80;
    server_name ${SITE_DOMAIN} www.${SITE_DOMAIN};

    client_max_body_size 2m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Photos from the media library (#109): file names never change content, so browsers cache them for a year.
    location /uploads/ {
        proxy_pass http://waafa_api/api/v1/media/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The API sends the year-long immutable cache header and nosniff.
        limit_except GET HEAD { deny all; }
    }

    # Admin photo uploads (up to 12 MB); everything else keeps the 2 MB limit.
    location = /secure-admin-control/media/upload {
        client_max_body_size 13m;
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 60s;
    }

    location / {
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwritten, never appended: the web's rate limits read the first address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
