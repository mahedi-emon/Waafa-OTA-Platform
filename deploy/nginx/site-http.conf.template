# Before the certificate exists (and in the CI smoke run): the ACME challenge plus the site over HTTP.

upstream waafa_web {
    server web:3000;
    keepalive 32;
}

# Uploaded photos (#109) come straight from the API's media volume.
upstream waafa_api {
    server api:4000;
    keepalive 8;
}

# Form posts and sign-ins: 30 a minute per address with a short burst (the web and API add their own limits).
map $request_method $waafa_post_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $waafa_post_key zone=waafa_posts:10m rate=30r/m;
limit_req_status 429;

# Compression in nginx (issue 126): the web's own compression is off behind it (next.config.ts), so Node spends its
# CPU on rendering. Text types only; photos and video are already compressed. Brotli (issue 332) for every browser that
# accepts it, about a fifth smaller than gzip; gzip for the rest.
brotli on;
brotli_comp_level 5;
brotli_min_length 1024;
brotli_types text/plain text/css text/xml application/javascript application/json application/xml
    application/rss+xml application/manifest+json image/svg+xml text/x-component;
gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css text/xml application/javascript application/json application/xml
    application/rss+xml application/manifest+json image/svg+xml text/x-component;

# Hashed build files, optimised images and the public media are cached here (issue 126), so repeat requests never
# reach Node. 600 MB on disk at most; entries unused for 14 days are dropped.
proxy_cache_path /var/cache/nginx/waafa levels=1:2 keys_zone=waafa_static:8m max_size=600m inactive=14d
    use_temp_path=off;

# next/image answers AVIF, WebP or the original depending on the browser's Accept header: one cache entry per format.
map $http_accept $waafa_image_format {
    ~image/avif avif;
    ~image/webp webp;
    default     original;
}

server_tokens off;

# Requests for any other host name (bare IP, scanners) are dropped.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 80;
    server_name ${SITE_DOMAIN} www.${SITE_DOMAIN};

    client_max_body_size 2m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Photos from the media library (#109): file names never change content, so browsers cache them for a year.
    location /uploads/ {
        proxy_pass http://waafa_api/api/v1/media/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The API sends the year-long immutable cache header and nosniff.
        limit_except GET HEAD { deny all; }
    }

    # Customer files for forms (issue 232: visa documents, payment slips, attachments; JPG, PNG or PDF up to 5 MB).
    location = /api/uploads {
        client_max_body_size 6m;
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 60s;
    }

    # Staff documents on a booking (issue 242: e-tickets, vouchers, invoices; JPG, PNG or PDF up to 5 MB).
    location = /secure-admin-control/files/attach {
        client_max_body_size 6m;
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 60s;
    }

    # Admin photo uploads (up to 12 MB); everything else keeps the 2 MB limit.
    location = /secure-admin-control/media/upload {
        client_max_body_size 13m;
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 60s;
    }

    # Admin video uploads (MP4 or WebM up to 50 MB, D0 R3): the only route with this limit.
    location = /secure-admin-control/media/upload-video {
        client_max_body_size 51m;
        limit_req zone=waafa_posts burst=5 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Build files are content-hashed: cache them for a month (issue 126).
    location /_next/static/ {
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_cache waafa_static;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
    }

    # Optimised images: one entry per URL and image format (issue 126).
    location /_next/image {
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_cache waafa_static;
        proxy_cache_key "$scheme$host$request_uri|$waafa_image_format";
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
    }

    # Sample photos and video clips shipped with the site (public/media); admin uploads live under /uploads/.
    location /media/ {
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_cache waafa_static;
        # Next serves public files with max-age=0; nginx keeps them a day anyway (deploys rarely change them).
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_valid 200 1d;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_lock on;
    }

    location / {
        limit_req zone=waafa_posts burst=20 nodelay;
        proxy_pass http://waafa_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwritten, never appended: the web's rate limits read the first address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
