# WAAFA production settings for deploy/compose.yml. Copy to deploy/.env on the server and fill in every value.
# Never commit deploy/.env, never paste it in chat or a screenshot. Secrets: generate each with
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Images built by GitHub Actions on every push to main (.github/workflows/docker.yml). With IMAGE_REPO set, deploy.sh
# pulls them; empty, it builds on this server. IMAGE_TAG: latest, or a commit's 7-character sha to pin or roll back.
IMAGE_REPO=emon6107/waafa-ota-platform
IMAGE_TAG=latest

# Public address of the site, no trailing slash (canonical URLs, sitemap, admin cookies). Must match the GitHub
# variable SITE_URL the web image was built with (default https://waafasworld.com).
SITE_URL=https://waafasworld.com
# The domain nginx serves (www redirects to it) and the email Let's Encrypt sends certificate notices to.
SITE_DOMAIN=waafasworld.com
ACME_EMAIL=

# Database password (letters and digits only, 32+ characters).
POSTGRES_PASSWORD=
# API secrets: three different values, 48 characters each.
JWT_SECRET=
REVALIDATE_SECRET=
INTAKE_KEY=
# Encrypts flight, hotel and payment API secrets saved in Admin › Integrations. Never change it once secrets are saved
# (they would have to be entered again).
PROVIDER_SECRET_KEY=

# Email: Resend (RESEND_API_KEY) or any SMTP server (SMTP_URL=smtp://user:pass@host:587). One is required.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=Waafa <no-reply@waafasworld.com>
# The inbox that receives new leads, orders and payment proofs.
STAFF_ALERT_EMAIL=

# Google sign-in (docs/DEPLOY.md 5b): the OAuth web client for this domain. Used until Admin › Integrations ›
# Sign-in has its own Google record; set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First Super Admin, created on the first start only (12+ character password). Remove both after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudflare Turnstile now lives in Admin › Integrations (issue 284): leave these empty. Old keys here are moved into
# Admin once by the first deploy that carries issue 284; empty both lines after that.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
