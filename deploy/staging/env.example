# Staging (deploy/staging/README.md): copy to /opt/waafa-staging/.env on the staging VPS. New secrets only.
STAGING=1
BACKUP_CRON=off
IMAGE_REPO=emon6107/waafa-ota-platform
IMAGE_TAG=latest
SITE_URL=https://staging.waafasworld.com
SITE_DOMAIN=staging.waafasworld.com
ACME_EMAIL=
# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
JWT_SECRET=
REVALIDATE_SECRET=
INTAKE_KEY=
PROVIDER_SECRET_KEY=
# Email for staff alerts on staging (a test inbox); keys for outside services go into its Admin › Integrations,
# Sandbox accounts only.
SMTP_URL=
MAIL_FROM=Waafa staging <no-reply@waafasworld.com>
STAFF_ALERT_EMAIL=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
